<?xml version="1.0" encoding="UTF-16"?>
<!--
  mcpoll headless poll — Windows Task Scheduler template (Lisa, TM-1 follow-up).
  Operator example for the standalone poller CLI (bin/mcpoll.dart) against
  agent hosts that need no per-host token. Per-user task, logon + repeat
  trigger, NO elevation, NO stored password. Install:
  scripts/mcpoll/install-windows.ps1 (manual path).

  Scheduler invariants (reviewed against ADR-003):
  - Task path \MyControlPanel\  => per-user scope, never system-wide.
  - No elevated run level, no stored password on the principal.
  - Action argv carries NO credential material of any kind: host names and
    file paths only. Vault-backed reads stay inside the app rail; scheduled
    mcpoll runs target open agents. Interactive runs needing a token pass
    it via the process environment (see scripts/mcpoll/README.md).
  Replace INSTALL_DIR at install time (e.g. %LOCALAPPDATA%\MyControlPanel).
-->
<Task version="1.4" xmlns="http://schemas.microsoft.com/windows/2004/02/mit/task">
  <RegistrationInfo>
    <Description>mcpoll agent poll (per-user, no elevation).</Description>
  </RegistrationInfo>
  <Triggers>
    <LogonTrigger>
      <Enabled>true</Enabled>
      <Repetition>
        <Interval>PT15M</Interval>
        <Duration>P1D</Duration>
        <StopAtDurationEnd>false</StopAtDurationEnd>
      </Repetition>
    </LogonTrigger>
  </Triggers>
  <Principals>
    <Principal id="Author">
      <LogonType>InteractiveToken</LogonType>
      <RunLevel>LeastPrivilege</RunLevel>
    </Principal>
  </Principals>
  <Settings>
    <MultipleInstancesPolicy>IgnoreNew</MultipleInstancesPolicy>
    <DisallowStartIfOnBatteries>false</DisallowStartIfOnBatteries>
    <StopIfGoingOnBatteries>false</StopIfGoingOnBatteries>
    <AllowHardTerminate>true</AllowHardTerminate>
    <StartWhenAvailable>true</StartWhenAvailable>
    <Enabled>true</Enabled>
    <Hidden>false</Hidden>
    <AllowDemandStart>true</AllowDemandStart>
  </Settings>
  <Actions Context="Author">
    <Exec>
      <Command>INSTALL_DIR\mcpoll.exe</Command>
      <Arguments>--consent --servers INSTALL_DIR\servers.json</Arguments>
    </Exec>
  </Actions>
</Task>
