<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  mcpoll headless poll — macOS LaunchAgent template (Lisa, TM-1 follow-up).
  Operator example for the standalone poller CLI (bin/mcpoll.dart) against
  agent hosts that need no per-host token. Per-user agent
  (~/Library/LaunchAgents/), NEVER a system-wide daemon, StartInterval
  900 s. Install: scripts/mcpoll/install-macos.sh.
  Replace @INSTALL_DIR@ at install time (e.g. ~/.local/share/mycontrolpanel).
-->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.mycontrolpanel.mcpoll</string>
  <key>ProgramArguments</key>
  <array>
    <string>@INSTALL_DIR@/mcpoll</string>
    <string>--consent</string>
    <string>--servers</string>
    <string>@INSTALL_DIR@/servers.json</string>
  </array>
  <key>StartInterval</key>
  <integer>900</integer>
  <key>RunAtLoad</key>
  <true/>
</dict>
</plist>
